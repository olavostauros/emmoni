# Copie para .env e ajuste. As senhas abaixo são as de desenvolvimento (db/init/01-roles.sql).
EMMONI_DB_PORT=55432

# Ingestão (papel emmoni_ingest)
DATABASE_URL=postgres://emmoni_ingest:emmoni_ingest@localhost:55432/emmoni?sslmode=disable
# Migrações (papel emmoni_owner)
DATABASE_URL_OWNER=postgres://emmoni_owner:emmoni_owner@localhost:55432/emmoni?sslmode=disable

# Banco de testes, recriado por `make test`
DATABASE_URL_TEST=postgres://emmoni_ingest:emmoni_ingest@localhost:55432/emmoni_test?sslmode=disable
DATABASE_URL_TEST_OWNER=postgres://emmoni_owner:emmoni_owner@localhost:55432/emmoni_test?sslmode=disable
DATABASE_URL_TEST_WEB=postgres://emmoni_web:emmoni_web@localhost:55432/emmoni_test?sslmode=disable

EMMONI_CLASSIFIER=agent
EMMONI_DATA_DIR=./data
EMMONI_CRAWL_CONTACT=contato@exemplo.com
